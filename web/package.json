{
  "name": "dragon-radar-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:bundle": "node scripts/check-default-bundle.mjs",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:reset": "playwright test --config playwright.reset.config.ts",
    "test:e2e:private": "playwright test --config playwright.private.config.ts",
    "test:e2e:ai:public": "playwright test --config playwright.ai-public.config.ts",
    "test:e2e:ai:private": "playwright test --config playwright.ai.config.ts",
    "test:e2e:production-isolation": "node scripts/test-production-isolation.mjs",
    "test:containers": "npm run test:e2e:production-isolation"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "echarts": "6.1.0",
    "lucide-react": "1.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "8.2.0",
    "vitest": "^4.0.18"
  }
}
