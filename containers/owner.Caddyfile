{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

https://localhost:8443 {
	tls internal
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Cache-Control no-store
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	request_body {
		max_size 131072
	}
	route {
		@wrongHost not header Host {$DRAGON_OWNER_AUTHORITY:localhost:8031}
		respond @wrongHost 403

		@health {
			method GET HEAD
			path /health/live /health/ready
		}
		reverse_proxy @health 127.0.0.1:8001

		@publishedRead {
			method GET HEAD
			path_regexp publishedRead ^/api/(snapshots/(list|lineage|[0-9a-fA-F-]{36})|index/[^/]+/history|market/(overview|sector-flow|sentiment/research|sentiment|heatmap|daily-ai(/archives)?)|topics/[^/]+|search|limit-up/(ladder|continuity)|role/(candidates|evidence)|rank/range|compare/curves|stock/[^/]+(/kline)?|news(/[^/]+)?|regulation/(status|events))$
		}
		reverse_proxy @publishedRead 127.0.0.1:8001

		@realtimeRead {
			method GET
			path /api/realtime/quotes /api/realtime/minutes /api/realtime/anomalies /api/realtime/lineage /api/market/sector-flow/intraday
		}
		reverse_proxy @realtimeRead 127.0.0.1:8001

		@lhbRead {
			method GET
			path_regexp lhbRead ^/api/lhb(/lineage|/seats/[^/]+)?$
		}
		reverse_proxy @lhbRead 127.0.0.1:8001

		@aiRead {
			method GET HEAD
			path_regexp aiRead ^/api/ai/task/[0-9a-fA-F-]{36}(/evidence/[A-Za-z0-9_-]{1,100}|/publication-eligibility)?$
		}
		reverse_proxy @aiRead 127.0.0.1:8001

		@aiWrite {
			method POST
			path_regexp aiWrite ^/api/ai/(summarize|topic-suggest|explain-stock|daily-review|task/[0-9a-fA-F-]{36}/(cancel|review|publish-daily|publish-summary|published-(daily|summary)/[0-9a-fA-F-]{36}/revoke))$
		}
		reverse_proxy @aiWrite 127.0.0.1:8001

		@newsReviewRead {
			method GET HEAD
			path_regexp newsReviewRead ^/api/news/[0-9a-fA-F-]{36}/associations/review-state$
		}
		reverse_proxy @newsReviewRead 127.0.0.1:8001

		@newsReviewWrite {
			method POST
			path_regexp newsReviewWrite ^/api/news/[0-9a-fA-F-]{36}/associations/review$
		}
		reverse_proxy @newsReviewWrite 127.0.0.1:8001

		@session {
			method GET HEAD
			path /api/owner/v1/session
		}
		reverse_proxy @session 127.0.0.1:8001

		@pair {
			method POST
			path /api/owner/v1/pair
		}
		reverse_proxy @pair 127.0.0.1:8001

		@logout {
			method DELETE
			path /api/owner/v1/session
		}
		reverse_proxy @logout 127.0.0.1:8001

		# Task 17 owner-only research namespace: manifest/run reads and the
		# submit/cancel writes are whitelisted by exact anchored patterns; every
		# other /api/research sibling falls through to the empty @api 404 below.
		@researchRead {
			method GET HEAD
			path_regexp researchRead ^/api/research/(capabilities|manifests/[0-9a-fA-F-]{36}|backtests/[0-9a-fA-F-]{36}(/config)?)$
		}
		reverse_proxy @researchRead 127.0.0.1:8001

		@researchWrite {
			method POST
			path_regexp researchWrite ^/api/research/backtests(/[0-9a-fA-F-]{36}/cancel)?$
		}
		reverse_proxy @researchWrite 127.0.0.1:8001

		@analysisRead {
			method GET HEAD
			path_regexp analysisRead ^/api/analysis/jobs/[0-9a-fA-F-]{36}$
		}
		reverse_proxy @analysisRead 127.0.0.1:8001

		@analysisWrite {
			method POST
			path_regexp analysisWrite ^/api/analysis/jobs(/[0-9a-fA-F-]{36}/cancel)?$
		}
		reverse_proxy @analysisWrite 127.0.0.1:8001

		@api path /api/* /health/*
		respond @api 404
		@write not method GET HEAD
		respond @write 405
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

https://:8443 {
	header {
		Cache-Control no-store
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	respond 403
}
